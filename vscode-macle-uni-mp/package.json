{
  "name": "vscode-macle-uni-mp",
  "displayName": "Telebirr MiniApp Dev Kit",
  "description": "Create Vue uni-app or React Taro projects, compile for Macle, inspect compatibility, and run or debug them in VS Code.",
  "version": "1.0.0",
  "publisher": "macle-community",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/macle-community/uni-mp-macle"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "main": "./lib/extension.js",
  "files": [
    "lib/**",
    "media/**",
    "snippets/**",
    "README.md"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:vue",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onView:macle.tools",
    "onCommand:macle.compileAndPreview",
    "onCommand:macle.compileDev",
    "onCommand:macle.openCompatibilityReport",
    "onCommand:macle.configureMauiLibrary",
    "onCommand:macle.createProject",
    "onCommand:macle.configureRunAndDebug",
    "onCommand:macle.showWelcomePage"
  ],
  "extensionPack": [
    "Vue.volar",
    "uni-helper.uni-app-schemas-vscode"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "macle",
          "title": "Macle",
          "icon": "./media/macle.svg"
        }
      ]
    },
    "views": {
      "macle": [
        {
          "id": "macle.tools",
          "name": "Macle Tools"
        }
      ]
    },
    "commands": [
      {
        "command": "macle.compileAndPreview",
        "title": "Macle: Compile & Preview in Macle",
        "category": "Macle"
      },
      {
        "command": "macle.compileDev",
        "title": "Macle: Compile uni-app for Macle",
        "category": "Macle"
      },
      {
        "command": "macle.openCompatibilityReport",
        "title": "Macle: Open Compatibility Report",
        "category": "Macle"
      },
      {
        "command": "macle.configureMauiLibrary",
        "title": "Macle: Configure MAUI UI Library",
        "category": "Macle"
      },
      {
        "command": "macle.createProject",
        "title": "Macle: New Project",
        "category": "Macle"
      },
      {
        "command": "macle.configureRunAndDebug",
        "title": "Macle: Configure Run and Debug",
        "category": "Macle"
      },
      {
        "command": "macle.showWelcomePage",
        "title": "Macle: Show Welcome Page",
        "category": "Macle"
      }
    ],
    "configuration": {
      "title": "Macle",
      "properties": {
        "macle.maui.targetFolder": {
          "type": "string",
          "default": "maui-components",
          "description": "Project-relative folder where the selected MAUI dist files are copied."
        },
        "macle.toolkit.configFile": {
          "type": "string",
          "default": "",
          "description": "Optional absolute or extension-relative path to a Macle toolkit JSON configuration file."
        }
      }
    },
    "snippets": [
      {
        "language": "javascript",
        "path": "./snippets/macle.code-snippets"
      },
      {
        "language": "typescript",
        "path": "./snippets/macle.code-snippets"
      },
      {
        "language": "vue",
        "path": "./snippets/macle.code-snippets"
      },
      {
        "language": "html",
        "path": "./snippets/macle.code-snippets"
      },
      {
        "language": "css",
        "path": "./snippets/macle.code-snippets"
      },
      {
        "language": "scss",
        "path": "./snippets/macle.code-snippets"
      },
      {
        "language": "less",
        "path": "./snippets/macle.code-snippets"
      }
    ]
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "libarchive-wasm": "^1.2.0"
  }
}
