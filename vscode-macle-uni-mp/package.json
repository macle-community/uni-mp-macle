{
  "name": "telebirr-miniapp-dev-kit",
  "displayName": "Telebirr MiniApp Dev Kit",
  "description": "Create Vue uni-app, React Taro, or Pure Macle projects, compile for Macle, inspect compatibility, and run or debug them in VS Code.",
  "version": "1.0.0",
  "publisher": "macle-community",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/macle-community/uni-mp-macle"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "main": "./lib/extension.js",
  "files": [
    "lib/**",
    "media/**",
    "snippets/**",
    "README.md",
    "LICENSE",
    "libarchive.wasm"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:vue",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:maml",
    "onView:macle.tools",
    "onCommand:macle.compileAndPreview",
    "onCommand:macle.buildAndRun",
    "onCommand:macle.startWatcher",
    "onCommand:macle.compileDev",
    "onCommand:macle.compileRelease",
    "onCommand:macle.openWebSimulator",
    "onCommand:macle.openCompatibilityReport",
    "onCommand:macle.configureMauiLibrary",
    "onCommand:macle.createProject",
    "onCommand:macle.configureRunAndDebug",
    "onCommand:macle.showWelcomePage"
  ],
  "extensionPack": [
    "Vue.volar",
    "uni-helper.uni-app-schemas-vscode"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "macle",
          "title": "Macle",
          "icon": "./media/macle.svg"
        }
      ]
    },
    "views": {
      "macle": [
        {
          "id": "macle.tools",
          "name": "Macle Tools"
        }
      ]
    },
    "commands": [
      {
        "command": "macle.compileAndPreview",
        "title": "Macle: Build & Run with Simulator",
        "category": "Macle"
      },
      {
        "command": "macle.buildAndRun",
        "title": "Macle: Build & Run with Simulator",
        "category": "Macle"
      },
      {
        "command": "macle.startWatcher",
        "title": "Macle: Start Watching Changes",
        "category": "Macle"
      },
      {
        "command": "macle.compileDev",
        "title": "Macle: Compile for Macle",
        "category": "Macle"
      },
      {
        "command": "macle.compileRelease",
        "title": "Macle: Compile for Macle (Release / Pack)",
        "category": "Macle"
      },
      {
        "command": "macle.openWebSimulator",
        "title": "Macle: Open Web Simulator",
        "category": "Macle"
      },
      {
        "command": "macle.openCompatibilityReport",
        "title": "Macle: Open Compatibility Report",
        "category": "Macle"
      },
      {
        "command": "macle.configureMauiLibrary",
        "title": "Macle: Configure MAUI UI Library",
        "category": "Macle"
      },
      {
        "command": "macle.createProject",
        "title": "Macle: New Project",
        "category": "Macle"
      },
      {
        "command": "macle.configureRunAndDebug",
        "title": "Macle: Configure Run and Debug",
        "category": "Macle"
      },
      {
        "command": "macle.showWelcomePage",
        "title": "Macle: Show Welcome Page",
        "category": "Macle"
      }
    ],
    "configuration": {
      "title": "Macle",
      "properties": {
        "macle.maui.targetFolder": {
          "type": "string",
          "default": "maui-components",
          "description": "Project-relative folder where the selected MAUI dist files are copied."
        },
        "macle.toolkit.localPath": {
          "type": "string",
          "default": "",
          "description": "Local path to an existing Macle DevToolkit folder (e.g. ~/macle/DevToolkit_26.6.0) or extracted toolkit directory. When set, tools and simulators are loaded directly from this directory."
        },
        "macle.toolkit.downloadUrl": {
          "type": "string",
          "default": "https://developer.ethiotelecom.et/developer_tools/static/download/DevToolkit_26.6.0-LG0001.zip",
          "description": "Download URL for the Macle DevToolkit archive."
        },
        "macle.toolkit.version": {
          "type": "string",
          "default": "26.6.0",
          "description": "DevToolkit version label."
        },
        "macle.toolkit.configFile": {
          "type": "string",
          "default": "",
          "description": "Optional absolute or extension-relative path to a Macle toolkit JSON configuration file."
        },
        "macle.compiler.path": {
          "type": "string",
          "default": "",
          "description": "Optional path to a custom macle-compiler CLI executable or engine-compiler index.js."
        },
        "macle.simulator.type": {
          "type": "string",
          "enum": [
            "platform",
            "web",
            "auto"
          ],
          "default": "platform",
          "description": "Simulator preference. 'platform' prioritizes the native desktop simulator window (Linux macle-simulator, macOS app, Windows exe). 'web' runs in the web browser. 'auto' chooses platform when available, with web fallback."
        },
        "macle.simulator.openIn": {
          "type": "string",
          "enum": [
            "vscode",
            "standalone",
            "browser"
          ],
          "default": "vscode",
          "enumDescriptions": [
            "Open the Macle Simulator inside VS Code in an embedded Webview panel.",
            "Open the Macle Simulator in a standalone desktop window.",
            "Open the Macle Simulator in an external web browser."
          ],
          "description": "Where to open the Macle Simulator."
        },
        "macle.simulator.path": {
          "type": "string",
          "default": "",
          "description": "Optional path to a custom Macle simulator launcher executable (e.g. macle-simulator, macle-simulator.app, or macle-simulator.exe)."
        },
        "macle.simulator.linuxUrl": {
          "type": "string",
          "default": "https://github.com/macle-community/simulator-linux/archive/refs/tags/v-1.0.0.zip",
          "description": "Download URL for the Linux simulator archive."
        },
        "macle.simulator.webUrl": {
          "type": "string",
          "default": "https://github.com/macle-community/simulator-web/archive/refs/tags/v1.0.0.zip",
          "description": "Download URL for the Web simulator archive."
        }
      }
    },
    "snippets": [
      {
        "language": "maml",
        "path": "./snippets/macle.code-snippets"
      },
      {
        "language": "javascript",
        "path": "./snippets/macle.code-snippets"
      },
      {
        "language": "typescript",
        "path": "./snippets/macle.code-snippets"
      },
      {
        "language": "vue",
        "path": "./snippets/macle.code-snippets"
      },
      {
        "language": "html",
        "path": "./snippets/macle.code-snippets"
      },
      {
        "language": "css",
        "path": "./snippets/macle.code-snippets"
      },
      {
        "language": "scss",
        "path": "./snippets/macle.code-snippets"
      },
      {
        "language": "less",
        "path": "./snippets/macle.code-snippets"
      }
    ]
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "libarchive-wasm": "^1.2.0"
  }
}
